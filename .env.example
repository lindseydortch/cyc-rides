SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only needed for `supabase start` (local dev) — supabase/config.toml reads
# these for the LinkedIn OIDC provider. On hosted Supabase, configure the
# LinkedIn provider in the dashboard instead (Authentication > Providers).
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=
